# ---------------------------------------------------------------------------
# LLM endpoint configuration
#
# This app talks to any OpenAI-compatible API. Pick one of the options below
# and comment out / delete the rest.
# ---------------------------------------------------------------------------

# Option 1 - Ollama (local, free, recommended)
#   ollama pull qwen2.5:1.5b
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

# Option 2 - Groq (free tier) - https://console.groq.com
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Option 3 - Inception (free tier) - https://inceptionlabs.ai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.inceptionlabs.ai/v1

# Option 4 - Fake client (offline, no key, deterministic echoes)
# OPENAI_API_KEY=fake
# OPENAI_BASE_URL=fake

# Option 5 - Real OpenAI
# OPENAI_API_KEY=sk-...
# (leave OPENAI_BASE_URL empty or unset)
